PORT=4000

# Toggle real infra on/off. Both default to OFF so the project runs
# immediately with zero external setup, using in-memory fallbacks.
MONGO_ENABLED=false
MONGO_URI=mongodb://127.0.0.1:27017/fleetdash

REDIS_ENABLED=false
REDIS_URL=redis://127.0.0.1:6379

# Built-in fleet simulator (set to false once you wire up a real GPS source)
SIMULATION_ENABLED=true
SIM_VEHICLE_COUNT=150
SIM_TICK_MS=250

BUCKET_MAX_POINTS=3600
