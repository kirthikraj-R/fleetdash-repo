{
  "name": "fleetdash-backend",
  "version": "1.0.0",
  "description": "FleetDash - High-Throughput Event-Driven Fleet Telemetry Backend",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "cross-env SIMULATION_ENABLED=false NODE_OPTIONS=--experimental-vm-modules jest --runInBand",
    "loadtest:bench": "node loadtest/throughput-bench.js"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "express": "^4.19.2",
    "socket.io": "^4.7.5",
    "socket.io-msgpack-parser": "^3.0.2",
    "ioredis": "^5.4.1",
    "mongoose": "^8.5.1",
    "@turf/turf": "^7.1.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "nanoid": "^5.0.7",
    "piscina": "^4.6.1"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "supertest": "^7.0.0",
    "cross-env": "^7.0.3"
  }
}
